---
import '../styles/global.css';
import '../styles/portal.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'My Patients Care | Doctor Workspace',
  description = 'A doctor workspace for appointments, patients, and prescriptions.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="application-name" content="DocVisitMobile" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#176b50" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/service-worker.js').catch((error) => {
          console.error('DocVisitMobile service worker registration failed:', error);
        });
      }
    </script>
  </body>
</html>
